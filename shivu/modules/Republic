import asyncio
import random
from pyrogram import filters, Client, types as t
from shivu import shivuu as bot  # Assuming this is your bot instance
from shivu import user_collection, collection

# Global variable to track the number of claims per user
user_claims = {}

# Allowed group chat ID
ALLOWED_GROUP_ID = -1002338924488
# Allowed user ID for restricted commands
ALLOWED_USER_ID = 7378476666

# Command: /reset_republic
@bot.on_message(filters.command("resetrep") & filters.group)
async def reset_republic_day(client, message: t.Message):
    if message.from_user.id != ALLOWED_USER_ID:
        await message.reply_text("🚫 You are not authorized to use this command.")
        return

    # Reset Republic Day character claims for all users
    await user_collection.update_many({}, {"$set": {"republic_characters": [], "republic_claimed": False}})
    await message.reply_text("✅ All users' Republic Day claims have been reset! 🇮🇳 Jai Hind!")

# Command: /republic
@bot.on_message(filters.command("republic") & filters.group)
async def republic_day(client, message: t.Message):
    user_id = message.from_user.id

    # Ensure the command is used in the allowed group
    if message.chat.id != ALLOWED_GROUP_ID:
        await message.reply_text(
            "🇮🇳 This command can only be used in the Blade Support group. Join here: [Blade Support](https://t.me/+xJdjLviEJvpmYjM9)",
            disable_web_page_preview=True
        )
        return

    # Fetch user data or initialize it
    user_data = await user_collection.find_one({'id': user_id}) or {"id": user_id, "republic_characters": []}
    claims_made = len(user_data.get("republic_characters", []))

    # Ensure the user hasn't exceeded 3 claims
    if claims_made >= 3:
        await message.reply_text("🎆 You have already claimed the maximum of 3 🇮🇳 Republic Day Festival characters!")
        return

    # Fetch a random 🎉 Festival character
    festival_characters = await collection.find({"rarity": "🎉 Festival"}).to_list(length=100)
    if not festival_characters:
        await message.reply_text("❌ No 🎉 Festival characters are currently available.")
        return

    selected_character = random.choice(festival_characters)

    # Check if the character is already in the user's Republic Day collection
    if any(char["id"] == selected_character["id"] for char in user_data["republic_characters"]):
        await message.reply_text(f"⚠️ Character ID **{selected_character['id']}** is already in your Republic Day collection. Try again!")
        return

    # Add the selected character to the user's Republic Day collection
    user_data["republic_characters"].append(selected_character)
    await user_collection.update_one(
        {"id": user_id},
        {"$set": {"republic_characters": user_data["republic_characters"]}},
        upsert=True
    )

    claims_left = 3 - len(user_data["republic_characters"])
    await message.reply_text(
        f"🎉 You received a Republic Day Festival character: **{selected_character['name']}** from **{selected_character['anime']}**! 🇮🇳\n\n"
        f"🌟 Character ID: {selected_character['id']}\n"
        f"🎆 You can claim {claims_left} more Festival characters.\n\n"
        f"✨ Happy Republic Day! Jai Hind! 🇮🇳"
    )

# Command: /see_festival
@bot.on_message(filters.command("seefest") & filters.group)
async def see_festival_characters(client, message: t.Message):
    if not message.reply_to_message:
        await message.reply_text("❗ Reply to a user's message to view their Republic Day Festival characters.")
        return

    replied_user_id = message.reply_to_message.from_user.id
    user_data = await user_collection.find_one({'id': replied_user_id})

    if not user_data or "republic_characters" not in user_data:
        await message.reply_text(f"⚠️ The user with ID **{replied_user_id}** has not claimed any Republic Day Festival characters.")
        return

    republic_characters = user_data["republic_characters"]
    character_list = "\n".join([f"ID: {character['id']} - Name: {character['name']}" for character in republic_characters])

    await message.reply_text(
        f"👤 **User ID**: {replied_user_id}\n\n"
        f"📜 **Claimed Republic Day Festival Characters**:\n{character_list}\n\n"
        f"✨ Jai Hind! 🇮🇳"
    )
