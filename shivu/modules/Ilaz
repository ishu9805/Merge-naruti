# Function to find and delete a specified user document by user_id
async def delete_user(user_id):
    user_document = await user_collection.find_one({"id": user_id})
    
    if user_document is None:
        return None  # Return None if no document is found

    # Create a backup before deleting
    filename = await backup_user_txt(user_id)
    
    # Delete the user document
    result = await user_collection.delete_one({"id": user_id})

    if result.deleted_count > 0:
        return filename  # Return the backup filename
    else:
        return None

