from shivu import shivuu as app, user_collection
from pyrogram import filters
from pyrogram.types import Message
import datetime

# Function to create a backup of a specified user document in .txt format
async def backup_user_txt(user_id):
    # Fetch the user document from the collection by user_id
    user_document = await user_collection.find_one({"id": user_id})
    
    if user_document is None:
        return None  # Return None if no document is found

    # Define the backup file name with a timestamp
    timestamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
    filename = f"user_{user_id}_backup_{timestamp}.txt"

    # Save the data to a .txt file
    with open(filename, 'w') as backup_file:
        backup_file.write(str(user_document) + '\n')  # Write the user document as a string

    return filename

# Command handler for the /backup_user command
@app.on_message(filters.command("buser") & filters.user(7378476666))
async def backup_user_command(_, message: Message):
    try:
        user_id = int(message.command[1])  # Extract user ID from the command
        
        user_backup_filename = await backup_user_txt(user_id)

        if user_backup_filename is None:
            await message.reply_text(f"No user found with ID: {user_id}")
            return
        
        await message.reply_document(user_backup_filename, caption=f"Backup created successfully for user {user_id}!")
    except IndexError:
        await message.reply_text("Please provide a user ID. Usage: /backup_user <user_id>")
    except ValueError:
        await message.reply_text("Invalid user ID format. Please provide a numeric user ID.")
    except Exception as e:
        await message.reply_text(f"Failed to create backup: {str(e)}")

# Function to create a backup of a specified collection in .txt format
async def backup_collection_txt(coll, coll_name):
    data = await coll.find().to_list(length=None)
    timestamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
    filename = f"{coll_name}_backup_{timestamp}.txt"
    
    with open(filename, 'w') as backup_file:
        for document in data:
            backup_file.write(str(document) + '\n')  # Write each document as a string
    
    return filename

