from shivu import shivuu as app, user_collection
from pyrogram import filters
from pyrogram.types import Message
import json

# Command handler for the /sorted command
@app.on_message(filters.command("sorted") & filters.reply)
async def add_user_command(_, message: Message):
    try:
        # Check if the replied message contains a document
        if not message.reply_to_message.document:
            await message.reply_text("Please reply to a message that contains a document.")
            return
        
        # Get the document file
        document = message.reply_to_message.document
        file_id = document.file_id

        # Download the document
        downloaded_file = await app.download_media(file_id)

        # Read the content of the downloaded file
        with open(downloaded_file, 'r') as file:
            user_data = file.read()

        # Parse the user data (assuming it's in JSON format)
        user_document = json.loads(user_data)

        # Insert the user document into the user_collection
        result = await user_collection.insert_one(user_document)

        if result.inserted_id:
            await message.reply_text("User document added to user_collection successfully!")
        else:
            await message.reply_text("Failed to add user document.")

    except json.JSONDecodeError:
        await message.reply_text("The document content is not valid JSON.")
    except Exception as e:
        await message.reply_text(f"An error occurred: {str(e)}")


